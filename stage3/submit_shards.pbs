#!/bin/bash
# PBS array job: each array element runs one shard of the Stage 3 candidate
# generation on its own CPUs.  Submit from anywhere with:
#     qsub stage3/submit_shards.pbs
# The array size (-J 0-3 = 4 shards) must match NUM_SHARDS below.
# Adjust ncpus / mem / walltime / queue to your allocation (placeholders below).
#PBS -N stage3_candidates
#PBS -J 0-3
#PBS -l select=1:ncpus=8:mem=32gb
#PBS -l walltime=24:00:00
#PBS -j oe
#PBS -o /home/levi0006/ureca/stage3/work/

NUM_SHARDS=4
cd /home/levi0006/ureca || exit 1
mkdir -p stage3/work

source /usr/local/anaconda2025/etc/profile.d/conda.sh
conda activate openfold3

# Use exactly the CPUs this job was given.
export OMP_NUM_THREADS=${NCPUS:-8} MKL_NUM_THREADS=${NCPUS:-8}

python stage3/generate_candidates.py --shard ${PBS_ARRAY_INDEX}/${NUM_SHARDS} --threads ${OMP_NUM_THREADS}

# After every element has finished, build the manifest once:
#   python stage3/generate_candidates.py --manifest-only
